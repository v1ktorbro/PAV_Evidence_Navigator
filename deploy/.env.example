# GitHub Container Registry owner. Lowercase only.
GHCR_OWNER=v1ktorbro

# The workflow replaces this value with the commit SHA at deployment time.
IMAGE_TAG=latest

# Use :80 for the first release by IP address. Replace with the real domain
# (for example, pav.example.com) after its DNS A record points to the VPS.
# Caddy will then obtain and renew HTTPS certificates automatically.
CADDY_SITE_ADDRESS=:80
